# Optional configuration (single-container mode runs out of the box without .env)

# Public entrypoint
FRONTEND_PORT=8081
VITE_API_BASE_URL=
VITE_NAVER_MAPS_KEY_ID=
VITE_WEBRTC_ICE_SERVERS=
# Optional in single-container mode (same-origin is allowed automatically)
APP_ORIGIN=
CORS_ALLOWED_ORIGINS=

# Backend
NODE_ENV=production
PORT=7860
DB_DRIVER=better-sqlite3
DB_PATH=/app/data/db/wedding.db
UPLOAD_ROOT=/app/data/uploads
FRONTEND_DIST_DIR=/app/public

# Auth (auto-generated and persisted in DB directory if omitted)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password
