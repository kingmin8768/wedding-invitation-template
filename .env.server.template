# Production environment template for Docker Compose deployment
# Copy to `.env` if you want to customize ports, passwords, or map keys.
# Single-container mode also runs without `.env` using auto-generated JWT secrets.

# Public entrypoint
FRONTEND_PORT=8081
APP_ORIGIN=
CORS_ALLOWED_ORIGINS=
VITE_API_BASE_URL=
VITE_NAVER_MAPS_KEY_ID=
VITE_WEBRTC_ICE_SERVERS=

# Backend runtime
NODE_ENV=production
PORT=7860
DB_DRIVER=better-sqlite3
DB_PATH=/app/data/db/wedding.db
UPLOAD_ROOT=/app/data/uploads
FRONTEND_DIST_DIR=/app/public

# JWT secrets (optional: auto-generated in /app/data/db/.runtime-secrets.json if omitted)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin bootstrap account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password
