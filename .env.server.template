# Production environment template for Docker Compose deployment
# Copy to `.env` on the server and replace every placeholder value.
# Do not commit the real `.env`.

# Public entrypoint
FRONTEND_PORT=8081
APP_ORIGIN=https://your-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-domain.example.com
VITE_API_BASE_URL=
VITE_NAVER_MAPS_KEY_ID=
VITE_WEBRTC_ICE_SERVERS=

# Backend runtime
NODE_ENV=production
PORT=3000
DB_DRIVER=better-sqlite3
DB_PATH=/app/data/wedding.db
UPLOAD_ROOT=/app/uploads

# JWT secrets
# Generate with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_plus_random_hex_access_secret
JWT_REFRESH_SECRET=replace_with_64_plus_random_hex_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin bootstrap account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# Notes
# 1. Keep backend internal-only; expose only the frontend container.
# 2. If you place a reverse proxy (Caddy/Nginx/Cloudflare) in front, route the domain to FRONTEND_PORT.
# 3. Persist these host paths:
#    - ./data/db
#    - ./data/uploads
